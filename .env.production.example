# Copy to .env on the deploy VM (next to docker-compose.prod.yml) and
# fill in real values. See docs/deploy-gcp-free.md for where each of
# these comes from.

# --- Image to pull (built by .github/workflows/deploy-image.yml) ---
# Lowercase org/repo — GHCR requires it.
APP_IMAGE="ghcr.io/steven-robert-eddy/larder:latest"

# --- Domain Caddy will request an HTTPS cert for ---
# Zero-signup option: <your-VM's-static-IP>.sslip.io (e.g. 34.123.45.67.sslip.io)
DOMAIN=""

# --- Database ---
POSTGRES_USER="larder"
POSTGRES_PASSWORD=""
POSTGRES_DB="larder"

# --- Auth.js ---
# Generate with: npx auth secret
AUTH_SECRET=""
# The single shared passphrase the login page asks for.
AUTH_PASSPHRASE=""

# --- Cloudflare R2 (S3-compatible) ---
# Endpoint: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_ENDPOINT=""
S3_BUCKET="larder-photos"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# Public bucket URL — the r2.dev one from the bucket's settings page,
# or a custom domain if you've attached one.
S3_PUBLIC_URL=""

# --- First-run seed data (only used the first time you run the seed) ---
SEED_USER_EMAIL=""
SEED_USER_PASSWORD=""

# --- AI extraction (import fallback + paste-a-blob) ---
# Get a key at console.anthropic.com (separate from any claude.ai
# subscription — pay-as-you-go, needs a small prepaid credit balance).
# Optional — unset means the web-import AI fallback and /import/paste
# both show a "not set up yet" message instead of failing the build.
# Treat this like a password: never commit a real value here.
ANTHROPIC_API_KEY=""

# --- Import clip bookmarklet (optional) ---
# Bearer token for /api/import/clip — lets a bookmarklet import recipes
# from sites that block the paste-a-URL path (e.g. Allrecipes). Leave
# blank to disable it. Generate with: openssl rand -hex 24
CLIP_TOKEN=""
