# Copy to .env for local development (docker compose up) and fill in
# real values for anything deployed. Nothing here has a hardcoded
# localhost default baked into the app itself — these are the values
# that make that true.

# --- App ---
BASE_URL="http://localhost:3000"
NODE_ENV="development"

# --- Database (Postgres) ---
POSTGRES_USER="larder"
POSTGRES_PASSWORD="larder"
POSTGRES_DB="larder"
DATABASE_URL="postgresql://larder:larder@localhost:5432/larder?schema=public"

# --- Seed data (prisma/seed.ts) ---
SEED_USER_EMAIL="you@example.com"
SEED_USER_PASSWORD="changeme123"

# --- Auth.js ---
# Generate with: npx auth secret
AUTH_SECRET="replace-with-a-random-32-byte-secret"
AUTH_URL="http://localhost:3000"

# --- Object storage (S3-compatible: Cloudflare R2, MinIO, etc.) ---
S3_ENDPOINT="http://localhost:9000"
S3_REGION="auto"
S3_BUCKET="larder-photos"
S3_ACCESS_KEY_ID="larder"
S3_SECRET_ACCESS_KEY="larderminio"
# Set true for path-style addressing (MinIO). Leave unset/false for R2.
S3_FORCE_PATH_STYLE="true"
# Public base URL photos are served from (MinIO console default shown;
# for R2 use your bucket's public dev URL or custom domain).
S3_PUBLIC_URL="http://localhost:9000/larder-photos"
MINIO_ROOT_USER="larder"
MINIO_ROOT_PASSWORD="larderminio"

# --- AI (used starting Phase 2 — import/extraction) ---
ANTHROPIC_API_KEY=""
